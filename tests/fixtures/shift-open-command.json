[
  {
    "name": "ordinary employee opening uses last counted cash and retains extensions",
    "credential": "wrong",
    "input": {
      "version": 1,
      "id": "new-shift",
      "openedAt": 200,
      "employeeId": "e1",
      "expectedShifts": [
        {
          "id": "latest",
          "status": "closed",
          "closedAt": 100,
          "countedCash": 80,
          "custom": {
            "keep": 0
          }
        },
        {
          "id": "older",
          "status": "closed",
          "closedAt": 50,
          "countedCash": 40
        }
      ],
      "expectedEmployees": [
        {
          "id": "e1",
          "name": "Кассир",
          "phone": "phone",
          "role": "employee",
          "custom": false
        },
        {
          "id": "a1",
          "name": "Администратор",
          "role": "admin"
        }
      ]
    },
    "expected": {
      "ok": true,
      "shifts": [
        {
          "id": "latest",
          "status": "closed",
          "closedAt": 100,
          "countedCash": 80,
          "custom": {
            "keep": 0
          }
        },
        {
          "id": "older",
          "status": "closed",
          "closedAt": 50,
          "countedCash": 40
        },
        {
          "id": "new-shift",
          "status": "open",
          "openedAt": 200,
          "openingCash": 80,
          "employeeId": "e1",
          "employeeName": "Кассир",
          "employeePhone": "phone",
          "openingSourceShiftId": "latest"
        }
      ],
      "shift": {
        "id": "new-shift",
        "status": "open",
        "openedAt": 200,
        "openingCash": 80,
        "employeeId": "e1",
        "employeeName": "Кассир",
        "employeePhone": "phone",
        "openingSourceShiftId": "latest"
      },
      "events": [
        "close",
        "render",
        "telegram",
        "monthly"
      ],
      "writes": 1
    }
  },
