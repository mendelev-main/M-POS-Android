  {
    "name": "nested recipe sums shared branches",
    "products": [
      {
        "id": "a",
        "name": "a",
        "type": "simple",
        "stock": 100
      },
      {
        "id": "b",
        "name": "b",
        "type": "simple",
        "stock": 100
      },
      {
        "id": "sub",
        "name": "sub",
        "type": "composite",
        "components": [
          {
            "productId": "a",
            "qty": 0.2
          },
          {
            "productId": "b",
            "qty": 2
          }
        ]
      },
      {
        "id": "root",
        "name": "root",
        "type": "composite",
        "components": [
          {
            "productId": "a",
            "qty": 0.1
          },
          {
            "productId": "sub",
            "qty": 3
          },
          {
            "productId": "a",
            "qty": 0.3
          }
        ]
      }
    ],
    "items": [
      {
        "productId": "root",
        "qty": 2
      }
    ],
    "expected": {
      "version": 1,
      "items": [
        {
          "productId": "a",
          "qty": 2
        },
        {
          "productId": "b",
          "qty": 12
        }
      ]
    },
    "valid": true
  },
